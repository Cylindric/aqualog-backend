# Mail Proxy configuration
SMTPFAST_API_KEY=...

AUTHENTIK_EMAIL__HOST=mailproxy

AUTHENTIK_EMAIL__USERNAME=changeme
AUTHENTIK_EMAIL__PASSWORD=changeme
AUTHENTIK_ERROR_REPORTING__ENABLED=true

# Authentication mode: "oauth" (default) validates bearer tokens against the
# OAuth2 config below. "none" is for local dev/test only - it skips token
# validation entirely and treats every request as the user identified by
# AQUALOG_AUTH_IMPERSONATE_USER_ID (must be an existing user id). Do not set
# AQUALOG_AUTH_MODE=none in any real deployment.
# AQUALOG_AUTH_MODE=none
# AQUALOG_AUTH_IMPERSONATE_USER_ID=00000000-0000-0000-0000-000000000000

# OAuth2 Configuration
AQUALOG_OAUTH_ISSUER_URL=https://auth.aqualog.home.cylindric.net/application/o/aqualog/
AQUALOG_OAUTH_AUDIENCE=your-aqualog-client-id
